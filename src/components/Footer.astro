---
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();

const navigation = [
  { label: 'Conócenos', href: '/patricio/' },
  { label: 'Trayectoria', href: '/patricio/#trayectoria' },
  { label: 'Propuestas', href: '/propuestas/' },
  { label: 'Concejales', href: '/concejales/' },
];

const socialLinks = [
  { label: 'Facebook', href: 'https://www.facebook.com/patricioalberto.valdiviesoespinosa', icon: 'mdi:facebook' },
  { label: 'Instagram', href: 'https://www.instagram.com/patriciovaldiviesoe/', icon: 'mdi:instagram' },
  { label: 'TikTok', href: 'https://www.tiktok.com/@patriciovaldiviesoe', icon: 'mdi:music-note' },
];
---

<footer class="bg-primary-dark text-white">
  <div class="container mx-auto px-5 pt-20 pb-8 md:px-8 sm:pt-24 lg:pt-32 lg:pb-10">
    <div class="mb-16 flex flex-col items-start justify-between gap-8 border-b border-white/15 pb-14 sm:mb-20 sm:pb-16 lg:flex-row lg:items-end" data-reveal>
      <h2 class="m-0 max-w-[14ch] text-[clamp(2.6rem,5.4vw,5.5rem)] leading-[1.02] font-bold tracking-[-.06em]">
        Juntos hacemos avanzar a Loja
      </h2>
      <span class="block h-3 w-28 shrink-0 bg-accent lg:mb-3 lg:w-40" aria-hidden="true"></span>
    </div>

    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8" data-reveal data-reveal-delay="100">
      <div class="lg:col-span-3">
        <a class="inline-flex flex-col text-white no-underline" href="/" aria-label="Patricio Valdivieso, inicio">
          <span class="text-3xl leading-[.82] font-extrabold tracking-[-.075em] uppercase">Patricio<br />Valdivieso</span>
          <span class="mt-4 text-sm font-semibold text-accent">Candidato a alcalde de Loja</span>
        </a>
        <p class="mt-7 max-w-[18rem] leading-relaxed text-white/60">Un proyecto cercano, preparado y comprometido con el futuro de nuestra ciudad.</p>
      </div>

      <nav class="lg:col-span-2" aria-label="Navegación del pie de página">
        <h3 class="m-0 text-lg font-bold">Explora</h3>
        <ul class="mt-6 grid list-none gap-4 p-0 text-white/65">
          {navigation.map((item) => <li><a class="transition-colors hover:text-accent" href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <h3 class="m-0 text-lg font-bold">Síguenos</h3>
        <ul class="mt-6 grid list-none gap-4 p-0">
          {
            socialLinks.map((item) => (
              <li>
                <a class="inline-flex items-center gap-3 text-white/65 transition-colors hover:text-accent" href={item.href} target="_blank" rel="noreferrer">
                  <Icon name={item.icon} size={20} />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="sm:col-span-2 lg:col-span-5 lg:pl-8">
        <h3 class="m-0 text-lg font-bold">Recibe nuestras novedades</h3>
        <p class="mt-3 max-w-lg leading-relaxed text-white/60">Conoce las propuestas, recorridos y próximos encuentros de la campaña.</p>
        <form class="mt-7" data-newsletter>
          <label class="sr-only" for="footer-email">Correo electrónico</label>
          <div class="flex items-center border-b border-white/35 focus-within:border-accent">
            <Icon class="shrink-0 text-white/55" name="mdi:email-outline" size={22} />
            <input
              class="min-w-0 flex-1 border-0 bg-transparent px-4 py-4 text-base text-white outline-none placeholder:text-white/45"
              id="footer-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="Tu correo electrónico"
              required
            />
            <button class="grid size-12 shrink-0 cursor-pointer place-items-center border-0 bg-transparent text-white transition-colors hover:text-accent" type="submit" aria-label="Suscribirme">
              <Icon name="mdi:arrow-right" size={25} />
            </button>
          </div>
          <p class="mt-4 min-h-6 text-sm text-accent" aria-live="polite" data-newsletter-status></p>
        </form>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-white/15 pt-7 text-sm text-white/50 sm:mt-20 sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0">© {year} Patricio Valdivieso. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a class="transition-colors hover:text-white" href="#privacidad">Privacidad</a>
        <a class="transition-colors hover:text-white" href="#terminos">Términos</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const status = document.querySelector<HTMLElement>('[data-newsletter-status]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !status) return;
    status.textContent = 'Gracias. Te mantendremos informado.';
    form.reset();
  });
</script>
