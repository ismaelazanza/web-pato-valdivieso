---
const candidateGroups = [
  {
    title: 'Distrito Norte',
    heading: 'Concejales del Distrito Norte',
    bannerClass: 'bg-primary text-white',
    roleClass: 'text-primary',
    panelClass: 'bg-[#f3f7fd]',
    accentClass: 'bg-primary',
    candidates: [
      { name: 'Carlos Alberto Chalaco Armijos', role: 'Candidato a concejal por el Distrito Norte', image: '/images/concejales/carlos-alberto-chalaco-armijos.avif' },
      { name: 'Stefany Caralina Zuñiga Jaramillo', role: 'Candidata a concejal por el Distrito Norte', image: '/images/concejales/stefany-caralina-zuniga-jaramillo.avif' },
      { name: 'Jhonattan Uyaguari Quezada', role: 'Candidato a concejal por el Distrito Norte', image: '/images/concejales/jhonattan-uyaguari-quezada.avif' },
      { name: 'Idania Nayely Flores Espinosa', role: 'Candidata a concejal por el Distrito Norte', image: '/images/concejales/idania-nayely-flores-espinosa.avif' },
      { name: 'Mateo Salvador Granda Songor', role: 'Candidato a concejal por el Distrito Norte', image: '/images/concejales/mateo-salvador-granda-songor.avif' },
    ],
  },
  {
    title: 'Distrito Sur',
    heading: 'Concejales del Distrito Sur',
    bannerClass: 'bg-[#d52b35] text-white',
    roleClass: 'text-[#b9232d]',
    panelClass: 'bg-[#fff4f4]',
    accentClass: 'bg-[#d52b35]',
    candidates: [
      { name: 'María Dolores Ruíz Jiménez', role: 'Candidata a concejal por el Distrito Sur', image: '/images/concejales/maria-dolores-ruiz-jimenez.avif' },
      { name: 'Mauricio Eduardo Coronel Jaramillo', role: 'Candidato a concejal por el Distrito Sur', image: '/images/concejales/mauricio-eduardo-coronel-jaramillo.avif' },
      { name: 'Ariana Thais Ríos Román', role: 'Candidata a concejal por el Distrito Sur', image: '/images/concejales/ariana-thais-rios-roman.avif' },
      { name: 'Hernan Vinicio Armijos Armijos', role: 'Candidato a concejal por el Distrito Sur', image: '/images/concejales/hernan-vinicio-armijos-armijos.avif' },
    ],
  },
  {
    title: 'Sector Rural',
    heading: 'Concejales Rurales',
    bannerClass: 'bg-accent text-primary-dark',
    roleClass: 'text-[#8a6800]',
    panelClass: 'bg-[#fffbea]',
    accentClass: 'bg-accent',
    candidates: [
      { name: 'Lenin Gabriel Cuenca Mendieta', role: 'Candidato a concejal rural', image: '/images/concejales/lenin-gabriel-cuenca-mendieta.avif' },
      { name: 'Tatiana Elizabeth Urgiles Lozada', role: 'Candidata a concejal rural', image: '/images/concejales/tatiana-elizabeth-urgiles-lozada.avif' },
    ],
  },
];
---

<section class="bg-surface py-20 sm:py-24 lg:py-32" aria-labelledby="candidates-title">
  <div class="container mx-auto px-5 md:px-8">
    <header class="mx-auto mb-14 max-w-3xl text-center sm:mb-20" data-reveal>
      <p class="mb-5 text-base font-semibold text-primary">Un equipo para representar a Loja</p>
      <h2 id="candidates-title" class="m-0 text-[clamp(2.7rem,5vw,5.2rem)] leading-none font-bold tracking-[-.06em] text-ink">
        Conoce a nuestros candidatos
      </h2>
      <p class="mx-auto mt-7 max-w-2xl text-lg leading-[1.75] text-ink/65">
        Perfiles comprometidos con escuchar, fiscalizar y construir acuerdos en beneficio de toda la ciudad.
      </p>
    </header>

    <div class="grid gap-20 sm:gap-24 lg:gap-32">
      {candidateGroups.map((group) => (
        <section aria-label={group.heading}>
          <header class:list={['px-6 py-7 sm:px-10 sm:py-9', group.bannerClass]} data-reveal>
            <p class="m-0 text-sm font-bold tracking-[.12em] uppercase opacity-75">{group.title}</p>
            <h3 class="mt-2 text-[clamp(2rem,4vw,4rem)] leading-none font-bold tracking-[-.05em]">{group.heading}</h3>
          </header>

          <div class="border-t border-l border-line">
            {group.candidates.map((candidate, index) => (
              <article class="grid border-r border-b border-line lg:grid-cols-2" data-reveal>
                <div
                  class:list={[
                    'relative flex min-h-[30rem] items-center justify-center overflow-hidden bg-secondary p-8 sm:min-h-[38rem]',
                    index % 2 === 1 ? 'lg:order-2' : '',
                  ]}
                >
                  <span class="absolute top-7 left-7 z-10 font-display text-7xl leading-none text-white/70 drop-shadow-sm sm:text-8xl" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <img
                    class="absolute inset-0 size-full object-cover object-top"
                    src={candidate.image}
                    alt={candidate.name}
                    width="1200"
                    height="1650"
                    loading="lazy"
                  />
                  <span class:list={['absolute right-0 bottom-0 z-10 h-3 w-28', group.accentClass]} aria-hidden="true" />
                </div>

                <div class:list={['flex min-h-[30rem] items-center p-8 sm:min-h-[38rem] sm:p-12 lg:p-[clamp(3rem,6vw,7rem)]', group.panelClass, index % 2 === 1 ? 'lg:order-1' : '']}>
                  <div class="max-w-xl">
                    <p class:list={['mb-5 text-base font-bold', group.roleClass]}>{candidate.role}</p>
                    <h4 class="m-0 text-[clamp(2.5rem,5vw,5rem)] leading-none font-bold tracking-[-.06em] text-ink">
                      {candidate.name}
                    </h4>
                    <div class:list={['mt-10 flex items-center gap-4 text-sm font-semibold', group.roleClass]}>
                      <span class:list={['h-px w-12', group.accentClass]} aria-hidden="true" />
                      Loja Compromiso de Todos
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
