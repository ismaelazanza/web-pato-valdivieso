---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Patricio Valdivieso | Loja avanza contigo',
  description = 'Sitio oficial de Patricio Valdivieso, candidato a la Alcaldía de Loja.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#083a78" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
