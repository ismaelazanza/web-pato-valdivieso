---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import PatricioProfile from '../components/PatricioProfile.astro';
import PatricioJourney from '../components/PatricioJourney.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
---

<BaseLayout
  title="Patricio Valdivieso | Biografía"
  description="Conoce la biografía, formación, experiencia y vocación de servicio de Patricio Valdivieso."
>
  <Header />
  <main>
    <PageHeader title="Patricio Valdivieso" />
    <PatricioProfile />
    <PatricioJourney />
  </main>
  <Footer />
  <ScrollReveal />
</BaseLayout>
